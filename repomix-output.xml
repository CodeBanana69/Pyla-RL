                image,
                star_drops_path + image_filename,
                region_data['star_drop'],
                threshold=STAR_DROP_TEMPLATE_THRESHOLD,
        ):
            if image_filename == "angelic_star_drop.png":
                return "angelic"
            if image_filename == "demonic_star_drop.png":
