        settings = {
            "discord_id": "12345",
            "ping_every_x_match": 2,
            "ping_every_x_minutes": 0,
        }

        self.assertEqual(_ping_content("match", settings), "")
        self.assertEqual(_ping_content("match", settings), "<@12345>")

